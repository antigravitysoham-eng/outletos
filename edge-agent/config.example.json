{
  "api": "http://localhost:8787",
  "api_key": "paste key from Integrations page",
  "outlet_id": "r1",
  "model": "rf-detr-nano.onnx",
  "ppe_model": "kitchen-ppe-dfine-n.onnx",
  "ppe_classes": ["hairnet", "no_hairnet", "gloves", "no_gloves", "apron", "no_apron", "spill", "label"],
  "fps": 2,
  "outbox": "outbox.db",
  "cameras": [
    { "id": "r1-hotline", "zone": "kitchen", "rtsp": "rtsp://127.0.0.1:8554/r1-hotline",
      "subzones": {
        "station": [[0.05, 0.35], [0.70, 0.35], [0.70, 1.0], [0.05, 1.0]],
        "sink":    [[0.70, 0.35], [0.85, 0.35], [0.85, 1.0], [0.70, 1.0]],
        "raw":     [[0.85, 0.35], [1.0, 0.35], [1.0, 1.0], [0.85, 1.0]],
        "door":    [[0.0, 0.0], [1.0, 0.0], [1.0, 0.35], [0.0, 0.35]]
      },
      "display": { "roi": [520, 40, 120, 50], "sensor_id": "r1-walkin", "digits": 3, "every_s": 60 } },
    { "id": "r1-pass", "zone": "pass", "rtsp": "rtsp://127.0.0.1:8554/r1-pass",
      "subzones": { "station": [[0.0, 0.3], [0.8, 0.3], [0.8, 1.0], [0.0, 1.0]], "sink": [[0.8, 0.3], [1.0, 0.3], [1.0, 1.0], [0.8, 1.0]] } },
    { "id": "r1-store", "zone": "storage", "rtsp": "rtsp://127.0.0.1:8554/r1-store" },
    { "id": "r1-entrance", "zone": "entrance", "rtsp": "rtsp://127.0.0.1:8554/r1-entrance",
      "subzones": { "door": [[0.0, 0.0], [0.5, 0.0], [0.5, 1.0], [0.0, 1.0]], "host": [[0.5, 0.0], [1.0, 0.0], [1.0, 1.0], [0.5, 1.0]] } }
  ],
  "_notes": [
    "rtsp URLs point at the local go2rtc/MediaMTX re-stream (one camera connection shared by analytics and live view).",
    "Use each camera's low-resolution sub-stream, e.g. Hikvision /Streaming/Channels/102, Dahua subtype=1.",
    "Subzone polygons are normalised 0-1 coordinates; the person's foot point decides the zone.",
    "model: any Apache-2.0 detector exported to ONNX (RF-DETR-Nano, D-FINE-N, DEIM-N, YOLOX-Nano). A .pt path uses Ultralytics (AGPL, dev only)."
  ]
}
